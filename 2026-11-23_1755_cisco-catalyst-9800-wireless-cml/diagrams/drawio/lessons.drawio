<mxfile><diagram name="p"><mxGraphModel dx="0" dy="0" grid="0" page="1" pageWidth="1600" pageHeight="790" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="fillColor=#FFFFFF;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="790" as="geometry"/></mxCell><mxCell id="c4" value="" style="fillColor=#049FD9;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="8" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;1.&lt;/b&gt;  Give the 9800-CL 4 vCPU and 8 GB (local mode); the default is smaller" style="rounded=1;arcSize=6;fillColor=#eef6fb;strokeColor=#049FD9;strokeWidth=2;fontSize=19;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="1440" height="76" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;2.&lt;/b&gt;  Virtual WLC: import the manual_certs trustpoint; in the lab, revocation-check none" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#049FD9;strokeWidth=2;fontSize=19;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="212" width="1440" height="76" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;3.&lt;/b&gt;  Shut the radio networks, set ap country, then bring them back" style="rounded=1;arcSize=6;fillColor=#eef6fb;strokeColor=#049FD9;strokeWidth=2;fontSize=19;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="304" width="1440" height="76" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;4.&lt;/b&gt;  Check the switch VLAN database (show vlan brief), not only the SVIs" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#049FD9;strokeWidth=2;fontSize=19;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="396" width="1440" height="76" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;5.&lt;/b&gt;  Policy tags map SSIDs to VLANs; the trunk must carry every client VLAN" style="rounded=1;arcSize=6;fillColor=#eef6fb;strokeColor=#049FD9;strokeWidth=2;fontSize=19;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="488" width="1440" height="76" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;6.&lt;/b&gt;  CML wireless capture plus controller logs isolate client-side faults fast" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#049FD9;strokeWidth=2;fontSize=19;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="1440" height="76" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;7.&lt;/b&gt;  Wireless nodes are beta: expect sim quirks (CLIENT2, no beacon-loss roaming)" style="rounded=1;arcSize=6;fillColor=#eef6fb;strokeColor=#049FD9;strokeWidth=2;fontSize=19;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="672" width="1440" height="76" as="geometry"/></mxCell><mxCell id="c5" value="Lessons learned" style="text;strokeColor=none;fillColor=none;fontSize=30;fontColor=#1d2733;align=left;verticalAlign=middle;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1520" height="46" as="geometry"/></mxCell><mxCell id="c6" value="The things that cost time in this lab" style="text;strokeColor=none;fillColor=none;fontSize=19;fontColor=#5b6b7b;align=left;verticalAlign=middle;html=1;whiteSpace=wrap