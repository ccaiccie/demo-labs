# Nautobot 3.2 + Gitea + CI Runner environment template
# Copy to .env on the deployment host and replace placeholder secrets.

NAUTOBOT_SECRET_KEY=replace-with-random-secret-key
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=replace-with-db-password
NAUTOBOT_REDIS_PASSWORD=replace-with-redis-password

NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@lab.internal
NAUTOBOT_SUPERUSER_PASSWORD=LabAdmin123!
NAUTOBOT_SUPERUSER_API_TOKEN=replace-with-40-char-hex-token

# Lab network device credentials (used by Nautobot Secrets / Nornir / CI runner)
DEVICE_USERNAME=admin
DEVICE_PASSWORD=LabDemo123!
DEVICE_ENABLE_SECRET=LabDemo123!

# Gitea credentials
GITEA_ADMIN_USER=netops-admin
GITEA_ADMIN_PASSWORD=LabGitea123!
GITEA_ADMIN_EMAIL=netops@lab.internal
GITEA_TOKEN=
