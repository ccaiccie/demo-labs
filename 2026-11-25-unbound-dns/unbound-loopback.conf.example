# Optional standalone lab, not OPNsense configuration. Copy before editing.
server:
    interface: 127.0.0.1
    port: 1053
    access-control: 127.0.0.0/8 allow
    username: ""
    chroot: ""
    directory: ""
    pidfile: ""
    use-syslog: no
    do-daemonize: no

    # Use a readable static root anchor from your trusted distro package.
    # This configuration does not refresh the file.
    trust-anchor-file: "/ABSOLUTE/PATH/TO/LAB-ROOT-ANCHOR.key"
    module-config: "validator iterator"

    local-zone: "branch.internal." static
    local-data: "inventory.branch.internal. 60 IN A 192.168.1.50"
    local-data-ptr: "192.168.1.50 inventory.branch.internal."
