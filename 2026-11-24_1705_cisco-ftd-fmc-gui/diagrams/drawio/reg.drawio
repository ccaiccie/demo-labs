<mxfile><diagram name="p"><mxGraphModel dx="0" dy="0" grid="0" page="1" pageWidth="1600" pageHeight="790" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="fillColor=#FFFFFF;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="790" as="geometry"/></mxCell><mxCell id="c4" value="" style="fillColor=#049FD9;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="8" as="geometry"/></mxCell><mxCell id="c18" value="Gotcha: if the FTD was set up with &lt;b&gt;ManageLocally = Yes&lt;/b&gt;, it runs Device Manager instead and will never register. That's why the day 0 config matters." style="rounded=1;arcSize=6;fillColor=#fdecea;strokeColor=#C0392B;strokeWidth=2;fontSize=17;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="650" width="870" height="100" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=block;startArrow=none;html=1;strokeColor=#7D3C98;strokeWidth=3;fontSize=16;fontColor=#7D3C98;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="190" as="sourcePoint"/><mxPoint x="1250" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="" style="endArrow=block;startArrow=none;html=1;strokeColor=#049FD9;strokeWidth=3;fontSize=16;fontColor=#049FD9;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="350" as="sourcePoint"/><mxPoint x="1250" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="" style="endArrow=block;startArrow=block;html=1;strokeColor=#C0392B;strokeWidth=3;fontSize=16;fontColor=#C0392B;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=10 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="470" as="sourcePoint"/><mxPoint x="1250" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="" style="endArrow=block;startArrow=none;html=1;strokeColor=#1E8449;strokeWidth=3;fontSize=16;fontColor=#1E8449;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="590" as="sourcePoint"/><mxPoint x="1250" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="How an FTD registers to the FMC" style="text;strokeColor=none;fillColor=none;fontSize=30;fontColor=#1d2733;align=left;verticalAlign=middle;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1520" height="46" as="geometry"/></mxCell><mxCell id="c6" value="Both sides must agree on the address and the registration key" style="text;strokeColor=none;fillColor=none;fontSize=19;fontColor=#5b6b7b;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1520" height="30" as="geometry"/></mxCell><mxCell id="c7" value="FTD1  192.168.122.71" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.rect;prIcon=firewall;fillColor=#FAFAFA;strokeColor=#005073;fontSize=18;fontColor=#1d2733;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="170.0" y="353.5" width="120.0" height="93.0" as="geometry"/></mxCell><mxCell id="c8" value="FMC1  192.168.122.70" style="verticalLabelPosition=bottom;sketch=0;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.server2;fillColor=#fafafa;strokeColor=#005073;fontSize=18;fontColor=#1d2733;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1343.0" y="350.5" width="54.0" height="99.0" as="geometry"/></mxCell><mxCell id="c9" value="1  Day 0 on the FTD: ManageLocally = No, FmcIp = 192.168.122.70, FmcRegKey" style="text;strokeColor=none;fillColor=none;fontSize=18;fontColor=#7D3C98;align=left;verticalAlign=middle;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="840" height="60" as="geometry"/></mxCell><mxCell id="c11" value="   (same as the CLI:  configure manager add 192.168.122.70 &lt;key&gt;)" style="text;strokeColor=none;fillColor=none;fontSize=18;fontColor=#5b6b7b;align=left;verticalAlign=middle;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="840" height="60" as="geometry"/></mxCell><mxCell id="c12" value="2  FMC GUI: Devices &gt; Add Device: host, display name, the same key, policy, licenses" style="text;strokeColor=none;fillColor=none;fontSize=18;fontColor=#049FD9;align=left;verticalAlign=middle;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="840" height="60" as="geometry"/></mxCell><mxCell id="c14" value="3  sftunnel on TCP 8305: mutual certificate exchange, then a permanent encrypted channel" style="text;strokeColor=none;fillColor=none;fontSize=18;fontColor=#C0392B;align=left;verticalAlign=middle;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="840" height="60" as="geometry"/></mxCell><mxCell id="c16" value="4  The FMC discovers the interfaces, assigns the policy and runs a first deployment" style="text;strokeColor=none;fillColor=none;fontSize=18;fontColor=#1E8449;align=left;verticalAlign=middle;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="540" width="840" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>