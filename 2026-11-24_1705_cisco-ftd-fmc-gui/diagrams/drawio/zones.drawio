<mxfile><diagram name="p"><mxGraphModel dx="0" dy="0" grid="0" page="1" pageWidth="1600" pageHeight="790" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="fillColor=#FFFFFF;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="790" as="geometry"/></mxCell><mxCell id="c4" value="" style="fillColor=#049FD9;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="8" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Zone INSIDE&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#1E8449;strokeWidth=2;fontSize=22;fontColor=#1E8449;verticalAlign=top;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="140" y="120" width="340" height="300" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Zone OUTSIDE&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#D35400;strokeWidth=2;fontSize=22;fontColor=#D35400;verticalAlign=top;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="340" height="300" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Zone DMZ&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#1F618D;strokeWidth=2;fontSize=22;fontColor=#1F618D;verticalAlign=top;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="340" height="300" as="geometry"/></mxCell><mxCell id="c10" value="FTD1 Eth0/1  inside  10.1.1.1/24" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#1E8449;strokeWidth=2;fontSize=16;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="155" y="190" width="310" height="62" as="geometry"/></mxCell><mxCell id="c11" value="FTD2 Eth0/1  inside  10.2.2.1/24" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#1E8449;strokeWidth=2;fontSize=16;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="155" y="270" width="310" height="62" as="geometry"/></mxCell><mxCell id="c12" value="FTD1 Eth0/0  outside  198.51.100.11/24" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#D35400;strokeWidth=2;fontSize=16;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="655" y="190" width="310" height="62" as="geometry"/></mxCell><mxCell id="c13" value="FTD2 Eth0/0  outside  198.51.100.12/24" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#D35400;strokeWidth=2;fontSize=16;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="655" y="270" width="310" height="62" as="geometry"/></mxCell><mxCell id="c14" value="FTD1 Eth0/2  dmz  10.1.50.1/24" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#1F618D;strokeWidth=2;fontSize=16;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1155" y="190" width="310" height="62" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Why zones?&lt;/b&gt;&lt;br&gt;A zone is a shared FMC object. Both firewalls put their inside interface in INSIDE, so one access rule &lt;b&gt;INSIDE → OUTSIDE&lt;/b&gt; works on FTD1 and FTD2.&lt;br&gt;Each interface also gets a logical name (inside, outside, dmz) that routing and the CLI use.&lt;br&gt;Routed-mode interfaces need a name, a zone and an IP address before they pass traffic." style="rounded=1;arcSize=6;fillColor=#eef6fb;strokeColor=#049FD9;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="140" y="470" width="1340" height="230" as="geometry"/></mxCell><mxCell id="c5" value="Interfaces and security zones" style="text;strokeColor=none;fillColor=none;fontSize=30;fontColor=#1d2733;align=left;verticalAlign=middle;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1520" height="46" as="geometry"/></mxCell><mxCell id="c6" value="Policies match zones, not interface names" style="text;strokeColor=none;fillColor=none;fontSize=19;fontColor=#5b6b7b;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1520" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>