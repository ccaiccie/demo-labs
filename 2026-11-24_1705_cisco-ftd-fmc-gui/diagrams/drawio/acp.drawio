;b&gt;Action&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#d6eaf8;strokeColor=#049FD9;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1260" y="120" width="220" height="50" as="geometry"/></mxCell><mxCell id="c12" value="1" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#5b6b7b;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="100" y="180" width="60" height="66" as="geometry"/></mxCell><mxCell id="c13" value="Block-SSH-Out" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#5b6b7b;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="170" y="180" width="340" height="66" as="geometry"/></mxCell><mxCell id="c14" value="INSIDE → OUTSIDE" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#5b6b7b;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="430" height="66" as="geometry"/></mxCell><mxCell id="c15" value="SSH (TCP 22)" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#5b6b7b;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="180" width="290" height="66" as="geometry"/></mxCell><mxCell id="c16" value="Block" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#C0392B;strokeWidth=2;fontSize=18;fontColor=#C0392B;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="