l=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="100" y="340" width="60" height="66" as="geometry"/></mxCell><mxCell id="c23" value="Allow-Web-DMZ" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#5b6b7b;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="170" y="340" width="340" height="66" as="geometry"/></mxCell><mxCell id="c24" value="OUTSIDE → DMZ   to WEB1" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#5b6b7b;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="340" width="430" height="66" as="geometry"/></mxCell><mxCell id="c25" value="HTTP (TCP 80)" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#5b6b7b;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="340" width="290" height="66" as="geometry"/></mxCell><mxCell id="c26" value="Allow" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#1E8449;strokeWidth=2;fontSize=18;fontColor=#1E8449;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1260" y="340" width="220" height="66" as="geometry"/></mxCell><mxCell id="c27" value="Default action:  &lt;b&gt;Block all traffic&lt;/b&gt;  (anything no rule allows is dropped)" style="rounded=1;arcSize=6;fillColor=#fdecea;strokeColor=#C0392B;strokeWidth=2;fontSize=19;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="100" y="430" width="1420" height="60" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Order matters&lt;/b&gt;&lt;br&gt;SSH from inside must hit rule 1 before rule 2 allows everything. Put rule 1 under rule 2 and it never matches." style="rounded=1;arcSize=6;fillColor=#eef6fb;strokeColor=#049FD9;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="690" height="200" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Rules match the real address&lt;/b&gt;&lt;br&gt;Rule 3 uses WEB1's inside address 10.1.50.10, not 198.51.100.110: on FTD the NAT is undone before access control looks at the packet." style="rounded=1;arcSize=6;fillColor=#eafaf1;strokeColor=#1E8449;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="830" y="520" width="690" height="200" as="geometry"/></mxCell><mxCell id="c5" value="Access control policy LAB-ACP" style="text;strokeColor=none;fillColor=none;fontSize=30;fontColor=#1d2733;align=left;verticalAlign=middle;fontStyle=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1520" height="46" as="geometry"/></mxCell><mxCell id="c6" value="Rules are checked top-down. First match wins." style="text;strokeColor=none;fillColor=none;fontSize=19;fontColor=#5b6b7b;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1520" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>