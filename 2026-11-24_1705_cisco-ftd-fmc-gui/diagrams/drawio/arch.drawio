<mxfile><diagram name="p"><mxGraphModel dx="0" dy="0" grid="0" page="1" pageWidth="1600" pageHeight="790" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="fillColor=#FFFFFF;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="790" as="geometry"/></mxCell><mxCell id="c4" value="" style="fillColor=#049FD9;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="8" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Management plane: FMC&lt;/b&gt;&lt;br&gt;Objects, zones, interfaces, routing, access control, NAT&lt;br&gt;Licensing, health, upgrades&lt;br&gt;Stores the events the firewalls send back&lt;br&gt;&lt;i&gt;The FMC never forwards a single user packet&lt;/i&gt;" style="rounded=1;arcSize=6;fillColor=#eef6fb;strokeColor=#049FD9;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="900" height="230" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Data plane: FTD&lt;/b&gt;&lt;br&gt;Routes, NATs and inspects traffic (Lina + Snort)&lt;br&gt;Gets its whole configuration from the FMC&lt;br&gt;Sends connection and intrusion events to the FMC" style="rounded=1;arcSize=6;fillColor=#f4ecf7;strokeColor=#7D3C98;strokeWidth=2;fontSize=18;fontColor=#1d2733;verticalAlign=middle;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860" y="470" width="680" height="190" as="geometry"/></mxCell><mxCell id="c16" value="Policy is built once on the FMC, then &lt;b&gt;deployed&lt;/b&gt; to every firewall that uses it. Change once, deploy everywhere." style="rounded=1;arcSize=6;fillColor=#eafaf1;strokeColor=#1E8449;strokeWidth=2;fontSize=19;fontColor=#1d2733;verticalAlign=middle;align=center;spacingTop=6;spacin