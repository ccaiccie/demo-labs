<mxCell id="byp" value="without network policies: /32 route, firewall bypassed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C50F1F;strokeWidth=2.5;fontSize=14;fontColor=#C50F1F;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="vm" target="pekv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="110"/><mxPoint x="150" y="40"/><mxPoint x="1328" y="40"/></Array></mxGeometry></mxCell>
<mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.5;fontSize=14;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vm" target="ilb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="180"/><mxPoint x="560" y="259"/></Array></mxGeometry></mxCell>
<mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.5;fontSize=14;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="ilb" target="fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.5;fontSize=14;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="fw" target="pekv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.5;fontSize=14;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="fw" target="peblob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="steps" value="&lt;b&gt;Four things make it work&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:1700px;font-size:17px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:4%;&quot;&gt;#&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:34%;&quot;&gt;Setting&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:26%;&quot;&gt;Where&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:36%;&quot;&gt;Why&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:4%;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;privateEndpointNetworkPolicies = Enabled&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;snet-pe&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:36%;&quot;&gt;Lets UDRs override the endpoint&#x27;s /32 route, and NSGs apply&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:4%;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;UDR 10.2.0.0/16 → 10.0.2.100&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;every client subnet + GatewaySubnet&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:36%;&quot;&gt;At least as specific as the endpoint VNet; a default route is not enough&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:4%;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;SNAT to the trust interface, or disableSnatOnPL = true&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;VM-Series NAT policy / NIC tag&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:36%;&quot;&gt;Keeps the return path on the same firewall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:4%;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;NSG on snet-pe: allow 10.0.2.0/24 only&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;snet-pe&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:36%;&quot;&gt;Anything that skips the firewall is dropped at the endpoint&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="1740" height="340" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="panpol"><mxGraphModel dx="0" dy="0" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="__frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="860" as="geometry"/></mxCell>
<mxCell id="fw" value="VM-Series (PAN-OS)" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=17;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="855" y="30" width="80" height="80" as="geometry"/></mxCell>
<mxCell id="obj" value="&lt;b&gt;Objects&lt;/b&gt;&lt;br&gt;Address: pe-kv 10.2.1.6 · pe-blob 10.2.1.5 · pe-dfs 10.2.1.7 · pe-file 10.2.1.8&lt;br&gt;Address group: &lt;b&gt;ag-pe-storage&lt;/b&gt; = blob, dfs, file&lt;br&gt;Custom URL category &lt;b&gt;cat-our-paas&lt;/b&gt;:&lt;br&gt;&amp;nbsp;kv-demo.vault.azure.net&lt;br&gt;&amp;nbsp;stdemo.blob.core.windows.net, stdemo.dfs.core.windows.net&lt;br&gt;Firewall DNS = 10.0.3.4 so FQDN objects resolve privately" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="800" height="330" as="geometry"/></mxCell>
<mxCell id="tls" value="&lt;b&gt;TLS and inspection&lt;/b&gt;&lt;br&gt;• Key Vault and Blob traffic is HTTPS: match the TLS server name (SNI) against cat-our-paas without decrypting&lt;br&gt;• Decrypt only if clients trust your forward-proxy CA; Azure SDKs use the OS trust store&lt;br&gt;• Never decrypt the vault if policy treats secrets as out of scope for inspection&lt;br&gt;• SMB 3 to Azure Files is encrypted end to end: control it with App-ID and addresses" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="980" y="30" width="800" height="330" as="geometry"/></mxCell>
<mxCell id="rules" value="&lt;b&gt;Security policy (top-down)&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:1720px;font-size:16px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:5%;&quot;&gt;#&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:15%;&quot;&gt;Name&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:21%;&quot;&gt;Source&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:12%;&quot;&gt;Destination&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:27%;&quot;&gt;Application / service&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:20%;&quot;&gt;Action / profiles&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:15%;&quot;&gt;app-to-keyvault&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:21%;&quot;&gt;TRUST · snet-app, snet-integration&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:12%;&quot;&gt;pe-kv&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:27%;&quot;&gt;ssl · tcp/443 · URL cat-our-paas&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;allow · vulnerability, spyware · log&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:15%;&quot;&gt;app-to-blob-dfs&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:21%;&quot;&gt;TRUST · snet-app&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:12%;&quot;&gt;ag-pe-storage&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:27%;&quot;&gt;ssl · tcp/443 · URL cat-our-paas&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;allow · AV, file blocking, WildFire if decrypted&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:15%;&quot;&gt;onprem-to-files&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:21%;&quot;&gt;TRUST · 172.16.0.0/16 file servers&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:12%;&quot;&gt;pe-file&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:27%;&quot;&gt;SMB application · tcp/445&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;allow · log&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:15%;&quot;&gt;deny-other-storage&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:21%;&quot;&gt;any&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:12%;&quot;&gt;any&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:27%;&quot;&gt;URL *.blob/dfs/file.core.windows.net, *.vault.azure.net&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;&lt;b&gt;deny&lt;/b&gt; · log (exfiltration guard)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:15%;&quot;&gt;deny-to-pe&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:21%;&quot;&gt;any&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:12%;&quot;&gt;PE subnets&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:27%;&quot;&gt;any&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;deny · log&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;NAT&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:15%;&quot;&gt;pe-snat&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:21%;&quot;&gt;TRUST&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:12%;&quot;&gt;PE subnets&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:27%;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;source NAT to ethernet1/2 (skip if disableSnatOnPL)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="1760" height="450" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="except"><mxGraphModel dx="0" dy="0" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="__frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="860" as="geometry"/></mxCell>
<mxCell id="stg" value="Storage account · public endpoint side" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=17;fontColor=#201F1E;strokeWidth=2;fillColor=#F4ECFA;strokeColor=#8661C5;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="520" height="500" as="geometry"/></mxCell>
<mxCell id="blob" value="stdemo" style="image;aspect=fixed;html=1;image=img/lib/azure2/storage/Storage_Accounts.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="62" height="62" as="geometry"/></mxCell>
<mxCell id="acl" value="Default action: &lt;b&gt;Deny&lt;/b&gt;&lt;br&gt;VNet rules (service endpoints)&lt;br&gt;IP rules&lt;br&gt;&lt;b&gt;Resource instance rules&lt;/b&gt;: one named resource, for example a specific AI Search service&lt;br&gt;&lt;b&gt;Trusted services exception&lt;/b&gt;: every instance of every listed service" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="660" y="250" width="480" height="290" as="geometry"/></mxCell>
<mxCell id="cmk" value="Storage → Key Vault&lt;br&gt;customer-managed key" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=220;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="bkp" value="Azure Backup, Monitor,&lt;br&gt;Event Grid, Defender" style="image;aspect=fixed;html=1;image=img/lib/azure2/management_governance/Monitor.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=220;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="srch" value="AI Search, Data Factory,&lt;br&gt;Synapse" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Users.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=220;" vertex="1" parent="1"><mxGeometry x="120" y="480" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="x1" value="managed identity · trusted bypass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8661C5;strokeWidth=2.5;fontSize=14;fontColor=#8661C5;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="cmk" target="blob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="x2" value="trusted services exception" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E8590C;strokeWidth=2.5;fontSize=14;fontColor=#E8590C;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="bkp" target="acl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="x3" value="resource instance rule (preferred)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.5;fontSize=14;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.85;" edge="1" parent="1" source="srch" target="acl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="fw" value="VM-Series" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="1400" y="270" width="66" height="66" as="geometry"/></mxCell>
<mxCell id="fwn" value="None of these flows touch your firewall: they never enter your VNets" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FDECEC;strokeColor=#C50F1F;" vertex="1" parent="1"><mxGeometry x="1250" y="400" width="520" height="160" as="geometry"/></mxCell>
<mxCell id="bottom" value="&lt;b&gt;Govern what the firewall can&#x27;t see&lt;/b&gt;: prefer resource instance rules over the broad trusted-services exception, grant only the data roles each managed identity needs, and turn on diagnostic logs for both services. The Network Security Perimeter, generally available for Key Vault and Storage, can replace scattered IP and instance rules with one boundary and one access log." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=21;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1760" height="240" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="exfil"><mxGraphModel dx="0" dy="0" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="__frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="860" as="geometry"/></mxCell>
<mxCell id="sp1" value="Spoke 1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=17;fontColor=#201F1E;strokeWidth=2;fillColor=#F1F8EC;strokeColor=#5C9E31;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="380" height="480" as="geometry"/></mxCell>
