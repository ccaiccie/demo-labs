<mxCell id="stset" value="Public network access: &lt;b&gt;Disabled&lt;/b&gt;&lt;br&gt;Allow shared key access: &lt;b&gt;off&lt;/b&gt;&lt;br&gt;Anonymous blob access: &lt;b&gt;off&lt;/b&gt;&lt;br&gt;Minimum TLS 1.2&lt;br&gt;Firewall rules apply only to the public endpoint, not the private endpoint" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="1320" y="250" width="430" height="310" as="geometry"/></mxCell>
<mxCell id="zt" value="&lt;b&gt;One endpoint and one DNS zone per sub-resource&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:620px;font-size:16px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:18%;&quot;&gt;Sub-resource&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:52%;&quot;&gt;Private DNS zone&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:30%;&quot;&gt;Used by&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;blob&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;privatelink.blob.core.windows.net&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;Blob SDK, AzCopy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;dfs&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;privatelink.dfs.core.windows.net&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;Data Lake Gen2 (ABFS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;file&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;privatelink.file.core.windows.net&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;SMB 445, Azure Files REST&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;queue&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;privatelink.queue.core.windows.net&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;Queues&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;table&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;privatelink.table.core.windows.net&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;Tables&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;web&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;privatelink.web.core.windows.net&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;Static website&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;*_secondary&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;same zones&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;RA-GRS read replicas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="650" height="520" as="geometry"/></mxCell>
<mxCell id="e1" value="Private Link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8661C5;strokeWidth=2.5;fontSize=14;fontColor=#8661C5;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.92;entryX=0;entryY=0.92;" edge="1" parent="1" source="spe" target="stg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="gotcha" value="&lt;b&gt;The classic Data Lake gotcha&lt;/b&gt;: you create only a blob endpoint, but the app uses the dfs endpoint. dfs still resolves to the public IP, and with public access off you get 403 errors. Inventory every endpoint your tools call. Azure Files from on-premises needs the &lt;b&gt;file&lt;/b&gt; endpoint and TCP 445 open across ExpressRoute or VPN and on the firewall." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="1740" height="220" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
