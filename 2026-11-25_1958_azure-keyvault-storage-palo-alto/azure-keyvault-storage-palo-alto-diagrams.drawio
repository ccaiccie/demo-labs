<mxCell id="dns" value="kv-demo.vault.azure.net → CNAME kv-demo.&lt;b&gt;privatelink.vaultcore.azure.net&lt;/b&gt; → 10.2.1.6&lt;br&gt;On-premises: forward &lt;b&gt;vault.azure.net&lt;/b&gt; and &lt;b&gt;vaultcore.azure.net&lt;/b&gt; to the resolver inbound endpoint" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="760" height="150" as="geometry"/></mxCell>
<mxCell id="kvg" value="Key Vault  kv-demo" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=17;fontColor=#201F1E;strokeWidth=2;fillColor=#F4ECFA;strokeColor=#8661C5;" vertex="1" parent="1"><mxGeometry x="950" y="60" width="820" height="480" as="geometry"/></mxCell>
<mxCell id="kv" value="kv-demo" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="1320" y="110" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="kvset" value="&lt;b&gt;Networking&lt;/b&gt;: public network access &lt;b&gt;Disabled&lt;/b&gt; (private endpoint only)&lt;br&gt;&lt;b&gt;Exception&lt;/b&gt;: Allow trusted Microsoft services to bypass this firewall: still applies when public access is disabled&lt;br&gt;&lt;b&gt;Access&lt;/b&gt;: Azure RBAC permission model (Key Vault Secrets User for apps)&lt;br&gt;&lt;b&gt;Recovery&lt;/b&gt;: soft delete + purge protection on" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="980" y="230" width="760" height="290" as="geometry"/></mxCell>
<mxCell id="e_pl" value="Private Link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8661C5;strokeWidth=2.5;fontSize=14;fontColor=#8661C5;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="pe" target="kv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="202"/><mxPoint x="470" y="100"/><mxPoint x="1290" y="100"/><mxPoint x="1290" y="140"/></Array></mxGeometry></mxCell>
<mxCell id="who" value="&lt;b&gt;Who reaches the vault, and how&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:1700px;font-size:17px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:42%;&quot;&gt;Caller&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:30%;&quot;&gt;Path&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:28%;&quot;&gt;Through the Palo Alto?&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:42%;&quot;&gt;App VM, App Service (VNet integration), on-premises&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;Private endpoint 10.2.1.6&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;&lt;b style=&#x27;color:#107C10&#x27;&gt;Yes, with the UDR and network policies&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:42%;&quot;&gt;Trusted services: disk encryption, SQL TDE, Azure Backup, App Gateway certificates&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;Microsoft backbone, trusted bypass&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;&lt;b style=&#x27;color:#C50F1F&#x27;&gt;No&lt;/b&gt;: governed by RBAC and the bypass setting&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:42%;&quot;&gt;Services not on the trusted list (for example Azure DevOps)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;Blocked unless they come through your network&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;Yes, via a self-hosted agent in a spoke&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="1740" height="260" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
