<mxCell id="h4" value="SMB 445" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.5;fontSize=14;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="fw" target="pefile"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="h5" value="DNS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2.5;fontSize=14;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="opdns" target="res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="bottom" value="Mount with the normal name: \\stdemo.file.core.windows.net\share. Many ISPs block 445, but over ExpressRoute or VPN to a private endpoint it is private traffic. Use identity-based SMB authentication (Entra Kerberos or AD DS) instead of the storage account key." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1760" height="160" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="check"><mxGraphModel dx="0" dy="0" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="__frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="860" as="geometry"/></mxCell>
<mxCell id="tr" value="&lt;b&gt;Troubleshooting 403s and timeouts&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:820px;font-size:17px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:48%;&quot;&gt;Symptom&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:52%;&quot;&gt;Likely cause&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:48%;&quot;&gt;Key Vault 403 &quot;client address is not authorized&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;Name resolved to the public IP: zone link or forwarder missing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:48%;&quot;&gt;Key Vault 403 &quot;not an approved private link&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;Endpoint pending or for a different vault&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:48%;&quot;&gt;Storage 403 AuthorizationFailure&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;Wrong sub-resource (dfs vs blob) or request reached the public endpoint&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:48%;&quot;&gt;Storage 403 AuthorizationPermissionMismatch&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;Network fine; missing data role (RBAC)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:48%;&quot;&gt;Timeout, no firewall log&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;UDR missing or network policies off&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:48%;&quot;&gt;Firewall log shows allow, then aged-out&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;Asymmetric return: SNAT or disableSnatOnPL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:48%;&quot;&gt;Firewall deny on URL category&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;Account or vault not in cat-our-paas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="860" height="820" as="geometry"/></mxCell>
<mxCell id="ck" value="&lt;b&gt;Deployment checklist&lt;/b&gt;&lt;br&gt;&lt;br&gt;☐ Private endpoint per vault and per storage sub-resource you use&lt;br&gt;☐ privatelink zones linked to the hub; forwarders for the public zones on-premises&lt;br&gt;☐ Network policies Enabled on snet-pe; NSG allows the firewall only&lt;br&gt;☐ UDR for the PE range on client subnets and GatewaySubnet&lt;br&gt;☐ SNAT or disableSnatOnPL on the VM-Series&lt;br&gt;☐ PAN-OS: named-account URL category, explicit deny for other storage and vault FQDNs&lt;br&gt;☐ Public network access Disabled on both services&lt;br&gt;☐ Trusted bypass only if needed; resource instance rules over broad exceptions&lt;br&gt;☐ Key Vault RBAC, soft delete, purge protection&lt;br&gt;☐ Storage: shared key off, anonymous access off, TLS 1.2&lt;br&gt;☐ Azure Policy to deny public access and deploy DNS zone groups&lt;br&gt;☐ Diagnostic logs + firewall logs to the same SIEM" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=21;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="910" y="20" width="870" height="820" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>