<mxCell id="ours" value="stdemo&lt;br&gt;(ours, via PE)" style="image;aspect=fixed;html=1;image=img/lib/azure2/storage/Storage_Accounts.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="58" height="58" as="geometry"/></mxCell>
<mxCell id="theirs" value="attacker-owned&lt;br&gt;storage account" style="image;aspect=fixed;html=1;image=img/lib/azure2/storage/Storage_Accounts.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="1040" y="370" width="58" height="58" as="geometry"/></mxCell>
<mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2.5;fontSize=14;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="vm" target="fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="a2" value="allowed: cat-our-paas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.5;fontSize=14;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="fw" target="ours"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="a3" value="denied: other *.blob.core.windows.net" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C50F1F;strokeWidth=2.5;fontSize=14;fontColor=#C50F1F;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="fw" target="theirs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ctl" value="&lt;b&gt;Layers against exfiltration&lt;/b&gt;&lt;br&gt;1. A private endpoint maps to &lt;b&gt;one&lt;/b&gt; account, not the whole service&lt;br&gt;2. Palo Alto: allow only your account names, deny every other storage and vault FQDN&lt;br&gt;3. Service endpoint policies on any subnet still using service endpoints&lt;br&gt;4. Disable shared key and SAS where possible; use Entra ID data roles&lt;br&gt;5. Defender for Storage and Key Vault for anomalous access alerts" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="1240" y="60" width="540" height="480" as="geometry"/></mxCell>
<mxCell id="bottom" value="&lt;b&gt;Why the wildcard is dangerous&lt;/b&gt;: an allow rule for *.blob.core.windows.net lets any workload copy data to any storage account in the world, including the attacker&#x27;s. Allow exactly your account and vault names, keep the explicit deny below it, and review the URL logs for blocked storage FQDNs; they are often the first sign of a data theft attempt." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=21;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="1760" height="260" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
