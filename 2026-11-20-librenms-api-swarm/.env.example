# Local-only lab defaults for the librenms-api Docker Compose stack.
# Copy to .env (gitignored) to override any values locally.
# NEVER commit real secrets or production credentials.

TZ=UTC
PUID=1000
PGID=1000

# MariaDB local lab credentials (local-only defaults)
MYSQL_DATABASE=librenms
MYSQL_USER=librenms
MYSQL_PASSWORD=lab-local-db-pass
MYSQL_ROOT_PASSWORD=lab-local-root-pass

# LibreNMS Web UI URL (bound strictly to 127.0.0.1:8012)
LIBRENMS_APP_URL=http://127.0.0.1:8012

# Local SNMPv2c community shared by the 6 lab SNMP agent containers
LAB_SNMP_COMMUNITY=lab-ro-community
