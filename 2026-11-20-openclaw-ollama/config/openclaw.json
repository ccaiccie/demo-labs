{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789
  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434",
        "api": "ollama",
        "models": [
          {
            "id": "llama3.1-64k:latest",
            "name": "Llama 3.1 8B 64K (Local Ollama)",
            "contextWindow": 64000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/llama3.1-64k:latest"
      },
      "workspace": "/home/node/.openclaw/workspace"
    }
  }
}
