<mxCell id="c1" value="VM-Series in the hub VNet" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=19;fontColor=#201F1E;strokeWidth=2;fillColor=#EAF3FB;strokeColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="570" height="810" as="geometry"/></mxCell>
<mxCell id="c1plb" value="Public LB" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Load_Balancers.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="90" y="110" width="54" height="54" as="geometry"/></mxCell>
<mxCell id="c1f1" value="FW1" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="230" y="230" width="58" height="58" as="geometry"/></mxCell>
<mxCell id="c1f2" value="FW2" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="58" height="58" as="geometry"/></mxCell>
<mxCell id="c1ilb" value="ILB · HA ports" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Load_Balancers.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="300" y="380" width="54" height="54" as="geometry"/></mxCell>
<mxCell id="c1a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E8590C;strokeWidth=2.5;fontSize=14;fontColor=#E8590C;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="c1plb" target="c1f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c1b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2.5;fontSize=14;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="c1ilb" target="c1f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c1c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2.5;fontSize=14;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="c1ilb" target="c1f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c1n" value="• You run the VMs: sizing, zones, upgrades, bootstrap, VMSS autoscale&lt;br&gt;• Full PAN-OS: GlobalProtect, decryption, every profile&lt;br&gt;• Panorama + Azure plugin for Dynamic Address Groups&lt;br&gt;• Active/active behind load balancers, or active/passive with floating IPs" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="530" height="330" as="geometry"/></mxCell>
<mxCell id="c2" value="Cloud NGFW for Azure in the hub VNet" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=19;fontColor=#201F1E;strokeWidth=2;fillColor=#EAF3FB;strokeColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="615" y="30" width="570" height="810" as="geometry"/></mxCell>
<mxCell id="c2pub" value="public subnet (delegated)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#201F1E;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7FA7D1;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="520" height="110" as="geometry"/></mxCell>
<mxCell id="c2fw" value="Cloud NGFW (SaaS)" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="870" y="240" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="c2prv" value="private subnet (delegated)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#201F1E;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#7FA7D1;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="350" width="520" height="110" as="geometry"/></mxCell>
<mxCell id="c2n" value="• Azure-native ISV service: Palo Alto runs scaling and HA&lt;br&gt;• Spokes send traffic with a UDR to its private IP&lt;br&gt;• Policy from a local rulestack, Panorama, or Strata Cloud Manager&lt;br&gt;• Fewer knobs than full PAN-OS; check the feature matrix" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="635" y="490" width="530" height="330" as="geometry"/></mxCell>
<mxCell id="c3" value="Cloud NGFW in a Virtual WAN hub" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=19;fontColor=#201F1E;strokeWidth=2;fillColor=#EAF3FB;strokeColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="1210" y="30" width="570" height="810" as="geometry"/></mxCell>
<mxCell id="c3hub" value="vWAN hub" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Virtual_WAN_Hub.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="1420" y="120" width="70" height="70" as="geometry"/></mxCell>
<mxCell id="c3fw" value="Cloud NGFW" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="1430" y="260" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="c3a" value="routing intent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2.5;fontSize=14;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="c3hub" target="c3fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c3n" value="• Routing intent: private and internet traffic → Cloud NGFW, no UDRs to maintain&lt;br&gt;• Inter-hub and branch traffic inspected too&lt;br&gt;• Private endpoints: enable route-table network policies on their subnets for symmetry&lt;br&gt;• Best when you already run vWAN" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="1230" y="490" width="530" height="330" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="gov"><mxGraphModel dx="0" dy="0" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="__frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="860" as="geometry"/></mxCell>
<mxCell id="L1" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;Identity&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Entra ID auth and managed identities; turn off shared keys and local auth (storage shared key, SQL Entra-only)&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="1540" height="122" as="geometry"/></mxCell>
<mxCell id="L1i" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Managed_Identities.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="50" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="L2" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;Resource network&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Public network access disabled; private endpoints only; NSP for the public side that must stay&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="230" y="158" width="1540" height="122" as="geometry"/></mxCell>
<mxCell id="L2i" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Private_Endpoint.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="188" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="L3" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;Subnet&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;PE network policies on; NSG with ASGs on snet-pe allows only the firewall or SNAT sources&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="230" y="296" width="1540" height="122" as="geometry"/></mxCell>
<mxCell id="L3i" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Network_Security_Groups.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="326" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="L4" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;Palo Alto VM-Series&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;App-ID, Threat Prevention, URL/FQDN control, decryption where possible, deny-and-log by default&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#E9F6EC;strokeColor=#107C10;" vertex="1" parent="1"><mxGeometry x="230" y="434" width="1540" height="122" as="geometry"/></mxCell>
<mxCell id="L4i" value="" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="462" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="L5" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;Governance&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Azure Policy: deny public network access, deploy private DNS zone groups, audit missing endpoints; Defender for Cloud&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="230" y="572" width="1540" height="122" as="geometry"/></mxCell>
<mxCell id="L5i" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/management_governance/Policy.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="602" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="L6" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;Observability&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Firewall logs to Strata Logging Service or Sentinel; Azure Monitor and NSP access logs; Network Watcher&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="230" y="710" width="1540" height="122" as="geometry"/></mxCell>
<mxCell id="L6i" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Azure_Sentinel.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="740" width="60" height="60" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="trouble"><mxGraphModel dx="0" dy="0" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="__frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="860" as="geometry"/></mxCell>
<mxCell id="T1" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;1 · DNS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;From the client: nslookup stgdemo.blob.core.windows.net must show the privatelink CNAME and 10.2.1.5. A public IP here means a zone link or forwarder is missing.&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="1540" height="148" as="geometry"/></mxCell>
<mxCell id="T1i" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/DNS_Zones.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="62" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="T2" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;2 · Routes&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Effective routes on the client NIC: the PE prefix → virtual appliance, and no active /32 InterfaceEndpoint route. The PE&#x27;s own NIC doesn&#x27;t show effective routes, so check the client side.&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="230" y="186" width="1540" height="148" as="geometry"/></mxCell>
<mxCell id="T2i" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Route_Tables.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="228" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="T3" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;3 · Firewall&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Monitor → Traffic, filter on the PE subnet: right rule, NAT applied, session end reason. No log at all means the packet never reached the firewall.&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="230" y="352" width="1540" height="148" as="geometry"/></mxCell>
<mxCell id="T3i" value="" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="392" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="T4" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;4 · Endpoint&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Connection state Approved; if NSGs are on for snet-pe, they must allow the firewall&#x27;s SNAT address or the real client range.&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="230" y="518" width="1540" height="148" as="geometry"/></mxCell>
<mxCell id="T4i" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Private_Endpoint.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="560" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="T5" value="&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;5 · Symmetry&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Works with SNAT but not without? Check the disableSnatOnPL tag on every dataplane NIC and that both directions use the same ILB frontend.&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="230" y="684" width="1540" height="148" as="geometry"/></mxCell>
<mxCell id="T5i" value="" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Network_Watcher.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="130" y="726" width="60" height="60" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="decide"><mxGraphModel dx="0" dy="0" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="__frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="860" as="geometry"/></mxCell>
<mxCell id="m" value="&lt;table style=&quot;border-collapse:collapse;width:1720px;font-size:23px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:20%;&quot;&gt;Option&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:16%;&quot;&gt;Through the Palo Alto?&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:13%;&quot;&gt;On-prem private path&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:17%;&quot;&gt;Exfiltration control&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:8%;&quot;&gt;Effort&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:26%;&quot;&gt;Use it when&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;A · Public endpoint + IP rule&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;Yes (egress)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;Firewall FQDN rules only&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:8%;&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;Quick start, service has no Private Link&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;B · Service endpoint on firewall subnet&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;Yes&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;Endpoint policies (Storage)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:8%;&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;Cheap Azure-only access to a few services&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;&lt;b&gt;C · Private endpoint + UDR&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;&lt;b&gt;Yes, with network policies&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;&lt;b&gt;Strong (per resource)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:8%;&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;&lt;b&gt;Default for production&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;D · VNet injection&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;Yes (like VMs)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;Yes&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;Strong&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:8%;&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;Dedicated tiers: SQL MI, ASE, APIM, AKS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;E · VNet integration, route all&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;Yes (app egress)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;Yes&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;Firewall egress policy&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:8%;&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;App Service / Functions calling out&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;F · Front Door PL / AppGW / DNAT&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;Depends on pattern&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;n/a&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;WAF + firewall&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:8%;&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;Publishing apps to the internet&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;G · Network Security Perimeter&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;No (PaaS side)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;Perimeter rules + logs&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:8%;&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;PaaS-to-PaaS and public PaaS that must stay&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:25px;margin-top:30px&quot;&gt;&lt;b&gt;Rule of thumb&lt;/b&gt;: private endpoints in a dedicated spoke, network policies on, a UDR per PE prefix to the ILB, SNAT or disableSnatOnPL, the resolver for DNS, public access off, and Azure Policy to keep it that way. Add E for egress, F for publishing, G for what can&#x27;t go private.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1760" height="820" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>