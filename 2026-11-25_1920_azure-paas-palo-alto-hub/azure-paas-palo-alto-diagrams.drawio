<mxCell id="ret" value="return can skip the firewall → asymmetric drop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C50F1F;strokeWidth=2.5;fontSize=14;fontColor=#C50F1F;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;entryX=0;entryY=0.8;" edge="1" parent="1" source="pe" target="vm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1469" y="600"/><mxPoint x="90" y="600"/><mxPoint x="90" y="328"/></Array></mxGeometry></mxCell>
<mxCell id="snat" value="after SNAT: 10.0.2.4 → 10.2.1.4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E8590C;strokeWidth=2.5;fontSize=14;fontColor=#E8590C;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.9;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="fw1" target="pe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="858" y="309"/></Array></mxGeometry></mxCell>
<mxCell id="o1" value="&lt;b&gt;Option 1 · SNAT on the firewall&lt;/b&gt;&lt;br&gt;source becomes the trust interface, so replies always return to it. Cost: the PaaS logs see the firewall IP." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="560" height="150" as="geometry"/></mxCell>
<mxCell id="o2" value="&lt;b&gt;Option 2 · disableSnatOnPL = true&lt;/b&gt;&lt;br&gt;tag on each firewall dataplane NIC (or VMSS instance). Keeps the real client IP. Causes a one-time reset of PE flows." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="620" y="690" width="560" height="150" as="geometry"/></mxCell>
<mxCell id="o3" value="&lt;b&gt;Either way&lt;/b&gt;&lt;br&gt;send both directions through the same ILB frontend so HA-ports hashing lands on the same firewall." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="1210" y="690" width="560" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
