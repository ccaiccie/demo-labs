<mxCell id="fw3" value="VM-Series&lt;br&gt;DNAT + SNAT" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="520" y="665" width="60" height="60" as="geometry"/></mxCell>
