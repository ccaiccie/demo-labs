<mxCell id="kv" value="Key Vault" style="image;aspect=fixed;html=1;image=img/lib/azure2/security/Key_Vaults.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="60" height="60" as="geometry"/></mxCell>
