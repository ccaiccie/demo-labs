<mxCell id="rta" value="&lt;b&gt;Effective routes on snet-app: after&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:820px;font-size:17px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;&quot;&gt;Prefix&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;&quot;&gt;Next hop&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;&quot;&gt;Source&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;&quot;&gt;0.0.0.0/0&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;&quot;&gt;Virtual appliance 10.0.2.100&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;&quot;&gt;User&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;&quot;&gt;10.2.0.0/16&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;&quot;&gt;Virtual appliance 10.0.2.100&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;&quot;&gt;User · &lt;b style=&#x27;color:#107C10&#x27;&gt;same length as the PE VNet&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;&quot;&gt;10.2.1.5/32&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;&quot;&gt;InterfaceEndpoint&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;&quot;&gt;&lt;s&gt;Invalid&lt;/s&gt;: overridden by network policy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#E9F6EC;strokeColor=#107C10;" vertex="1" parent="1"><mxGeometry x="910" y="520" width="860" height="320" 