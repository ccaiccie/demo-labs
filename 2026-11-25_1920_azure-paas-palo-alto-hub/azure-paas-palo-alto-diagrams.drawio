<mxCell id="oB" value="&lt;div style=&quot;font-size:22px;font-weight:bold;margin-top:70px&quot;&gt;B · Service endpoints&lt;/div&gt;&lt;div style=&quot;font-size:21px;margin-top:12px&quot;&gt;Enable on the firewall&#x27;s egress subnet, not the workload subnet. Source is the subnet, not a public IP.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="470" y="60" width="410" height="350" as="geometry"/></mxCell>
