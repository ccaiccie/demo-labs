<mxCell id="in1" value="diagnostics stay inside" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.5;fontSize=14;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1" source="kv" target="law"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rules" value="&lt;b&gt;Inbound access rules&lt;/b&gt;: IP prefixes or subscriptions&lt;br&gt;&lt;b&gt;Outbound access rules&lt;/b&gt;: FQDNs&lt;br&gt;&lt;b&gt;Access mode&lt;/b&gt;: Transition (learn, log) → Enforced&lt;br&gt;&lt;b&gt;Access logs&lt;/b&gt; for every allowed and denied call" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="650" y="330" width="640" height="260" as="geometry"/></mxCell>
<mxCell id="pub" value="Public clients" style="image;aspect=fixed;html=1;image=img/lib/azure2/identity/Users.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="90" y="140" width="56" height="56" as="geometry"/></mxCell>
<mxCell id="fw" value="VM-Series egress&lt;br&gt;20.55.10.7" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="62" height="62" as="geometry"/></mxCell>
<mxCell id="x1" value="denied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C50F1F;strokeWidth=2.5;fontSize=14;fontColor=#C50F1F;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="pub" target="blob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="x2" value="inbound IP rule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.5;fontSize=14;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.5;entryX=0.3;entryY=1;" edge="1" parent="1" source="fw" target="blob"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="578" y="431"/></Array></mxGeometry></mxCell>
<mxCell id="sp" value="Spoke VNet" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=17;fontColor=#201F1E;strokeWidth=2;fillColor=#F1F8EC;strokeColor=#5C9E31;" vertex="1" parent="1"><mxGeometry x="1400" y="60" width="380" height="560" as="geometry"/></mxCell>
<mxCell id="pe" value="Private endpoint" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Private_Endpoint.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="1560" y="160" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="x3" value="private traffic: not governed by NSP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8661C5;strokeWidth=2.5;fontSize=14;fontColor=#8661C5;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;entryX=0.8;entryY=1;" edge="1" parent="1" source="pe" target="blob"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1589" y="300"/><mxPoint x="608" y="300"/></Array></mxGeometry></mxCell>
<mxCell id="bottom" value="&lt;b&gt;NSP complements the firewall&lt;/b&gt;: it governs the public side of PaaS and PaaS-to-PaaS calls, while the VM-Series governs your VNets. When public network access is set to &quot;secured by perimeter&quot;, the perimeter&#x27;s rules decide who gets in. Coverage differs by service (GA vs preview), so check before you rely on it." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1760" height="180" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
