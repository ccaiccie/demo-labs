<mxCell id="fw" value="VM-Series (PAN-OS)" style="shape=mxgraph.networks.firewall;html=1;strokeColor=none;fillColor=#FA582D;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=17;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="855" y="40" width="90" height="90" as="geometry"/></mxCell>
<mxCell id="ifc" value="&lt;b&gt;Interfaces, zones, routing&lt;/b&gt;&lt;br&gt;ethernet1/1 · untrust 10.0.1.4 · zone UNTRUST&lt;br&gt;ethernet1/2 · trust 10.0.2.4 · zone TRUST&lt;br&gt;Static routes:&lt;br&gt;&amp;nbsp;0.0.0.0/0 → 10.0.1.1 (ethernet1/1)&lt;br&gt;&amp;nbsp;10.0.0.0/8, 172.16.0.0/16 → 10.0.2.1 (ethernet1/2)&lt;br&gt;&amp;nbsp;168.63.129.16/32 → each interface&#x27;s subnet gateway (LB probes)&lt;br&gt;Interface mgmt profile: HTTPS from 168.63.129.16 only" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="790" height="370" as="geometry"/></mxCell>
<mxCell id="obj" value="&lt;b&gt;Objects&lt;/b&gt;&lt;br&gt;Address: pe-sql 10.2.1.4 · pe-blob 10.2.1.5 · pe-kv 10.2.1.6&lt;br&gt;FQDN: stgdemo.blob.core.windows.net (firewall DNS = 10.0.3.4, so it resolves to the private IP)&lt;br&gt;Dynamic Address Groups: VNet, subnet and tag data from the Panorama Azure plugin&lt;br&gt;Custom URL category: *.blob.core.windows.net, *.vault.azure.net (SNI match)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="990" y="30" width="790" height="370" as="geometry"/></mxCell>
<mxCell id="rules" value="&lt;b&gt;Security policy (top-down)&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:1720px;font-size:17px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:5%;&quot;&gt;#&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:13%;&quot;&gt;Name&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:16%;&quot;&gt;Source&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:13%;&quot;&gt;Destination&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:11%;&quot;&gt;Application&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:17%;&quot;&gt;Service&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:25%;&quot;&gt;Action / profiles&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;app-to-sql&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;TRUST · snet-app&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;pe-sql&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:11%;&quot;&gt;mssql-db&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;tcp/1433 (Proxy policy)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:25%;&quot;&gt;allow · AV, vulnerability, spyware&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;app-to-blob&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;TRUST · snet-app&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;pe-blob&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:11%;&quot;&gt;ssl&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;tcp/443&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:25%;&quot;&gt;allow · URL category = your accounts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;onprem-to-kv&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;TRUST · 172.16.0.0/16&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;pe-kv&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:11%;&quot;&gt;ssl&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;tcp/443&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:25%;&quot;&gt;allow · logging&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;deny-to-pe&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;any&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;PE subnets&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:11%;&quot;&gt;any&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;any&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:25%;&quot;&gt;deny · log&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;intrazone-default&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;override&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:11%;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:25%;&quot;&gt;&lt;b&gt;deny + log&lt;/b&gt; (spoke-to-spoke is intrazone TRUST)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:5%;&quot;&gt;NAT&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;pe-snat&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;TRUST&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:13%;&quot;&gt;PE subnets&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:11%;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:17%;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:25%;&quot;&gt;source NAT to ethernet1/2 (skip if disableSnatOnPL)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="1760" height="410" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
