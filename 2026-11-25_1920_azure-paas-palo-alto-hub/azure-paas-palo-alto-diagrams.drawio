<mxCell id="app3" value="App Service" style="image;aspect=fixed;html=1;image=img/lib/azure2/app_services/App_Services.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=15;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="930" y="665" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="n3" value="+ one internet edge, Threat Prevention first&lt;br&gt;− DNAT + SNAT: client IP only in firewall logs&lt;br&gt;− L7 visibility needs inbound decryption&lt;br&gt;Variant: Gateway Load Balancer chained to a public frontend" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="1150" y="615" width="610" height="210" as="geometry"/></mxCell>
