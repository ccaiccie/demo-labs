# PentAGI .env (example) - REDACTED. Copy to .env and fill in.
# Full reference: https://raw.githubusercontent.com/vxcontrol/pentagi/main/.env.example
#
# Only the keys changed for this lab are shown. Everything else can stay at the
# upstream defaults from the official .env.example.

# --- LLM provider (billed usage) ---
OPEN_AI_KEY=REDACTED            # your OpenAI API key - NEVER commit the real value
OPEN_AI_SERVER_URL=https://api.openai.com/v1

# --- security: change these away from the defaults ---
COOKIE_SIGNING_SALT=REDACTED    # e.g. output of: openssl rand -hex 16
PENTAGI_POSTGRES_PASSWORD=REDACTED  # e.g. output of: openssl rand -hex 24

# --- pentest sandbox worker ---
# Isolated Kali-based worker image PentAGI launches to run tools:
DOCKER_DEFAULT_IMAGE_FOR_PENTEST=vxcontrol/kali-linux
# Attach spawned worker containers to this docker network so they can reach the
# local practice target by hostname (see victim/docker-compose.yml):
DOCKER_NETWORK=pentagi-network

# UI stays on localhost only:
PENTAGI_LISTEN_IP=127.0.0.1
PENTAGI_LISTEN_PORT=8443
PUBLIC_URL=https://localhost:8443
