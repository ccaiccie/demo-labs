# Nautobot 3.2.9 Local NetOps Lab Environment Example
# Copy to .env and replace placeholder values before running docker compose up -d.
# NEVER commit .env to version control.

# PostgreSQL
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
NAUTOBOT_DB_HOST=db
NAUTOBOT_DB_PORT=5432

# Redis
NAUTOBOT_REDIS_HOST=redis
NAUTOBOT_REDIS_PORT=6379
NAUTOBOT_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
NAUTOBOT_REDIS_DATABASE=0

# Nautobot Core
NAUTOBOT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
NAUTOBOT_ALLOWED_HOSTS=*
NAUTOBOT_DEBUG=False
NAUTOBOT_LOG_LEVEL=INFO
NAUTOBOT_INSTALLATION_METRICS_ENABLED=False
NAUTOBOT_METRICS_ENABLED=True
NAUTOBOT_MAX_PAGE_SIZE=1000
NAUTOBOT_GIT_ROOT=/opt/nautobot/git

# Initial Superuser Bootstrap (lab only)
NAUTOBOT_CREATE_SUPERUSER=true
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@lab.internal
NAUTOBOT_SUPERUSER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
NAUTOBOT_SUPERUSER_API_TOKEN=0000000000000000000000000000000000000000
