<mxCell id="ret" value="no SNAT: reply goes straight back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C50F1F;strokeWidth=2.5;fontSize=14;fontColor=#C50F1F;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="pe1b" target="vm1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="tb" value="&lt;b&gt;Keep the return path on the firewall&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:1120px;font-size:16px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:38%;&quot;&gt;Option&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:32%;&quot;&gt;What the endpoint sees&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:30%;&quot;&gt;NSG on snet-pe must allow&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;PAN-OS source NAT to ethernet1/2&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:32%;&quot;&gt;firewall IPs (10.0.2.4, 10.0.2.5)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;the firewalls&#x27; SNAT IPs only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;disableSnatOnPL = true tag on the firewall NICs&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:32%;&quot;&gt;the real client IP&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;the client subnets&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;Neither&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:32%;&quot;&gt;client IP, reply bypasses the firewall&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;asymmetric: session drops&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="1170" height="270" as="geometry"/></mxCell>
<mxCell id="nsgn" value="&lt;b&gt;NSG gotcha&lt;/b&gt;&lt;br&gt;An NSG matches the source IP that arrives at the endpoint. &quot;Allow only the firewall&quot; proves the path &lt;b&gt;only with SNAT&lt;/b&gt;. Without SNAT the NSG can&#x27;t tell a firewalled packet from a bypass, so the route is your control." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FDECEC;strokeColor=#C50F1F;" vertex="1" parent="1"><mxGeometry x="1220" y="580" width="560" height="270" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
