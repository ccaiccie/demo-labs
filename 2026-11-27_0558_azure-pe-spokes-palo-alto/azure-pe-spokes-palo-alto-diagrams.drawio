<mxCell id="files" value="&lt;b&gt;terraform/&lt;/b&gt;  (azurerm 4.x, validated with Terraform 1.17)&lt;table style=&quot;border-collapse:collapse;width:820px;font-size:15px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:28%;&quot;&gt;File&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:72%;&quot;&gt;What it builds&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;main.tf&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:72%;&quot;&gt;hub, VM-Series (3 NICs) + ILB, two spokes, peering, route tables, NSGs, VMs, storage, vault, PEs, DNS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;panos/fw-config.set&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:72%;&quot;&gt;PAN-OS zones, routes, rules, NAT to paste and commit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;tests/run-tests.sh&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:72%;&quot;&gt;curl from both VMs + effective routes&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="860" height="270" as="geometry"/></mxCell>
<mxCell id="tog" value="&lt;b&gt;Test toggles&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:830px;font-size:15px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:38%;&quot;&gt;Variable&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:62%;&quot;&gt;Effect&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;steer_through_firewall&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:62%;&quot;&gt;true: PE subnet routes exist. false: same-spoke bypass&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;snat_mode&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:62%;&quot;&gt;firewall_snat or disable_snat_on_pl (NIC tag + NSG sources)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;lock_pe_subnets_with_nsg&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:62%;&quot;&gt;NSG on snet-pe that only allows the firewall path&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#E9F6EC;strokeColor=#107C10;" vertex="1" parent="1"><mxGeometry x="910" y="580" width="870" height="270" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
