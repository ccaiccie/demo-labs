<mxCell id="t1" value="&lt;div style=&quot;font-size:52px;font-weight:bold;color:#201F1E&quot;&gt;Private endpoints in spoke VNets:&lt;br&gt;forcing the traffic through a Palo Alto in the hub&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="1560" height="210" as="geometry"/></mxCell>
<mxCell id="t2" value="&lt;div style=&quot;font-size:27px;color:#605E5C&quot;&gt;Why traffic bypasses the firewall, the routing rule that fixes it, symmetry, PAN-OS, and a Terraform test lab&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="150" y="340" width="1500" height="70" as="geometry"/></mxCell>
