<mxCell id="gt" value="&lt;b&gt;rt-gateway on GatewaySubnet&lt;/b&gt; (keep gateway route propagation &lt;b&gt;on&lt;/b&gt;)&lt;table style=&quot;border-collapse:collapse;width:850px;font-size:16px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:26%;&quot;&gt;Prefix&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:22%;&quot;&gt;Next hop&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:52%;&quot;&gt;Note&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;10.1.0.0/16&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:22%;&quot;&gt;10.0.2.100&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;spoke 1, includes its PE subnet&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;10.2.0.0/16&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:22%;&quot;&gt;10.0.2.100&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;spoke 2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;10.0.0.0/8&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:22%;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;too short: the endpoint /32s still win&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;0.0.0.0/0&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:22%;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:52%;&quot;&gt;never on GatewaySubnet&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="900" height="270" as="geometry"/></mxCell>
<mxCell id="od" value="&lt;b&gt;Also needed for on-premises&lt;/b&gt;&lt;br&gt;• Spokes peer with &lt;b&gt;use remote gateways&lt;/b&gt;, so on-prem learns 10.1/16 and 10.2/16&lt;br&gt;• On-prem DNS forwards blob.core.windows.net and vault.azure.net to the DNS Private Resolver inbound IP&lt;br&gt;• Return traffic: the spoke&#x27;s own route back to 172.16.0.0/16 via the ILB, or rely on SNAT" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="950" y="580" width="830" height="270" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
