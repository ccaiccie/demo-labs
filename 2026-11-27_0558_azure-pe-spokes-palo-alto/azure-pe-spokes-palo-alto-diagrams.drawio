<mxCell id="c1" value="10.1.0.0/16 → ILB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8661C5;strokeWidth=3;fontSize=14;fontColor=#8661C5;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.7;" edge="1" parent="1" source="vm2" target="ilb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="405"/><mxPoint x="920" y="302"/></Array></mxGeometry></mxCell>
<mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8661C5;strokeWidth=3;fontSize=14;fontColor=#8661C5;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5;exitY=0;entryX=1;entryY=0.75;" edge="1" parent="1" source="ilb" target="fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c3" value="SNAT → PE vault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8661C5;strokeWidth=3;fontSize=14;fontColor=#8661C5;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.2;entryX=0.5;entryY=0;" edge="1" parent="1" source="fw" target="pe1k"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="127"/><mxPoint x="840" y="12"/><mxPoint x="1484" y="12"/></Array></mxGeometry></mxCell>
<mxCell id="cn" value="&lt;b&gt;Plain hub-and-spoke: already forced&lt;/b&gt;&lt;br&gt;Spokes are only peered to the hub, so spoke 2 has no route to spoke 1 except your UDR to the ILB. The hub learns spoke 1&#x27;s prefix and the endpoint /32s over peering, so the firewall can reach them. Add the mirror route 10.2.0.0/16 on rt-spoke1-app." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#E9F6EC;strokeColor=#107C10;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="880" height="270" as="geometry"/></mxCell>
<mxCell id="mesh" value="&lt;b&gt;Watch out: spoke-to-spoke connectivity&lt;/b&gt;&lt;br&gt;Direct spoke peering, or a Virtual Network Manager mesh or connected group, propagates every endpoint /32 into the other spokes. Then the same rule applies: the UDR must be at least as long as the remote spoke&#x27;s VNet prefix (10.1.0.0/16 or 10.1.2.0/24), and network policies must be on." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FDECEC;strokeColor=#C50F1F;" vertex="1" parent="1"><mxGeometry x="930" y="580" width="850" height="270" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
