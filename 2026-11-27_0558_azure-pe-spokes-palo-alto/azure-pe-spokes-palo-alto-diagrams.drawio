<mxCell id="ti4" value="Private endpoint" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/Private_Endpoint.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=wrap;fontSize=18;fontColor=#201F1E;labelBackgroundColor=none;labelWidth=190;" vertex="1" parent="1"><mxGeometry x="1160" y="470" width="74" height="74" as="geometry"/></mxCell>
<mxCell id="t3" value="&lt;div style=&quot;font-size:22px;color:#323130&quot;&gt;Use case: every spoke keeps its own private endpoints next to its workloads. Goal: every connection to them is inspected and logged by the firewall.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=12;fontSize=18;fontColor=#201F1E;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="150" y="660" width="1500" height="110" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
