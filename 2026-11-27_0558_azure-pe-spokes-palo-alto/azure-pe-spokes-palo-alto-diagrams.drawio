<mxCell id="e_p1" value="peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A8886;strokeWidth=2.5;fontSize=14;fontColor=#8A8886;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.2;entryX=0;entryY=0.4;" edge="1" parent="1" source="hub" target="sp1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_p2" value="peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A8886;strokeWidth=2.5;fontSize=14;fontColor=#8A8886;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="hub" target="sp2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_op" value="ER / VPN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A8886;strokeWidth=2.5;fontSize=14;fontColor=#8A8886;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="users" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_byp" value="direct: firewall never sees it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C50F1F;strokeWidth=2.5;fontSize=14;fontColor=#C50F1F;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;dashPattern=8 5;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="vm1" target="pe1b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rt" value="&lt;b&gt;Effective routes on vm1 (no fix yet)&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:950px;font-size:16px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:20%;&quot;&gt;Prefix&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:22%;&quot;&gt;Next hop&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:30%;&quot;&gt;Source&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:28%;&quot;&gt;Result&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;10.1.2.4/32&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:22%;&quot;&gt;InterfaceEndpoint&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;Default (private endpoint)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;&lt;b&gt;wins for the blob endpoint&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;10.1.0.0/16&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:22%;&quot;&gt;VnetLocal&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;Default&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;covers everything else in spoke 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;10.2.0.0/16&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:22%;&quot;&gt;10.0.2.100&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;User&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;spoke 2 goes via the firewall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:20%;&quot;&gt;0.0.0.0/0&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:22%;&quot;&gt;10.0.2.100&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:30%;&quot;&gt;User&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;never beats the two above&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="1000" height="270" as="geometry"/></mxCell>
<mxCell id="why" value="&lt;b&gt;Two things send it around the firewall&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Inside a VNet, traffic between subnets is &lt;b&gt;VnetLocal&lt;/b&gt;: no hop, no appliance.&lt;br&gt;2. Each private endpoint injects a &lt;b&gt;/32&lt;/b&gt; route into its VNet and every peered VNet. Longest prefix wins, so a default route never catches it." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FDECEC;strokeColor=#C50F1F;" vertex="1" parent="1"><mxGeometry x="1050" y="580" width="730" height="270" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="rule"><mxGraphModel dx="0" dy="0" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="__frame" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="860" as="geometry"/></mxCell>
<mxCell id="rt" value="&lt;b&gt;Which UDR on snet-app overrides the endpoint&#x27;s /32?&lt;/b&gt;  (PE in spoke 1, VNet 10.1.0.0/16)&lt;table style=&quot;border-collapse:collapse;width:950px;font-size:19px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:34%;&quot;&gt;UDR prefix&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:28%;&quot;&gt;Network policies off&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:38%;&quot;&gt;Network policies on&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;0.0.0.0/0&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;no&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;&lt;b&gt;no&lt;/b&gt;: shorter than the VNet prefix&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;10.0.0.0/8&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;no&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;&lt;b&gt;no&lt;/b&gt;: shorter than the VNet prefix&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;10.1.0.0/16 (the VNet)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;no&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;yes, but all intra-VNet traffic hairpins&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;10.1.2.0/24 (the PE subnet)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;no&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;&lt;b&gt;yes: recommended&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;10.1.2.4/32 (one endpoint)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;yes (longest match)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:38%;&quot;&gt;yes, but one route per endpoint&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=21;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1000" height="330" as="geometry"/></mxCell>
<mxCell id="pol" value="&lt;b&gt;The switch: privateEndpointNetworkPolicies&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set on the &lt;b&gt;subnet that hosts the endpoints&lt;/b&gt;, not the client subnet.&lt;br&gt;&lt;br&gt;• &lt;b&gt;RouteTableEnabled&lt;/b&gt;: UDRs may override the /32&lt;br&gt;• &lt;b&gt;NetworkSecurityGroupEnabled&lt;/b&gt;: NSGs apply to endpoints&lt;br&gt;• &lt;b&gt;Enabled&lt;/b&gt;: both (use this)&lt;br&gt;&lt;br&gt;Terraform:&lt;br&gt;&lt;code&gt;private_endpoint_network_policies = &quot;Enabled&quot;&lt;/code&gt;&lt;br&gt;&lt;br&gt;The rule: the UDR prefix must be &lt;b&gt;at least as long&lt;/b&gt; as the endpoint VNet&#x27;s prefix." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#E9F6EC;strokeColor=#107C10;" vertex="1" parent="1"><mxGeometry x="1050" y="20" width="730" height="620" as="geometry"/></mxCell>
<mxCell id="tip" value="&lt;b&gt;Why the PE subnet route is the sweet spot&lt;/b&gt;&lt;br&gt;One route per spoke instead of one per endpoint, so you stay far below the 400-route limit. It only redirects traffic to endpoints, so app-to-app traffic inside the spoke stays local. New endpoints in that subnet are covered automatically. Keep endpoints in their own subnet so the prefix means exactly &quot;private endpoints&quot;." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="1000" height="260" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
