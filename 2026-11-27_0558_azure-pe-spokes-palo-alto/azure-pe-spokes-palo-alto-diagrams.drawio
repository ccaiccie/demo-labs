<mxCell id="f3" value="3 · on-premises" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#038387;strokeWidth=3;fontSize=14;fontColor=#038387;labelBackgroundColor=#FFFFFF;fontStyle=1;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="users" target="pe2b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="565"/><mxPoint x="1309" y="565"/></Array></mxGeometry></mxCell>
<mxCell id="fl" value="&lt;b&gt;Three flows, three different reasons they need a route&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:1700px;font-size:16px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:24%;&quot;&gt;Flow&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:34%;&quot;&gt;Why it bypasses or fails today&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:26%;&quot;&gt;Route that fixes it&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:16%;&quot;&gt;Where&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:24%;&quot;&gt;1 · vm1 → PE in its own spoke&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;VnetLocal and the /32 route&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;PE subnet 10.1.2.0/24 → 10.0.2.100&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;rt-spoke1-app&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:24%;&quot;&gt;2 · vm2 → PE in spoke 1&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;Spokes aren&#x27;t peered: no route at all (or a /32 if they are)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;10.1.0.0/16 → 10.0.2.100&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;rt-spoke2-app&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:24%;&quot;&gt;3 · on-prem → PE in spoke 2&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:34%;&quot;&gt;Gateway learns spoke prefixes and the /32s over peering&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;10.2.0.0/16 → 10.0.2.100&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:16%;&quot;&gt;rt-gateway&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=19;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="1760" height="260" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
