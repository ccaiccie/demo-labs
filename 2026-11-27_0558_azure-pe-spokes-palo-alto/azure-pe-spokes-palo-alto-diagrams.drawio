<mxCell id="mx" value="&lt;b&gt;Expected results from tests/run-tests.sh&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:1700px;font-size:17px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:28%;&quot;&gt;Setting&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:28%;&quot;&gt;vm1 → blob/vault (same spoke)&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:18%;&quot;&gt;vm2 → vault (cross spoke)&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:26%;&quot;&gt;Firewall sessions&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;steer = true, firewall_snat, NSG on&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;HTTP 4xx (reached)&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;HTTP 4xx&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;both flows, source NAT 10.0.2.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;steer = false, NSG on&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;&lt;b&gt;000 timeout&lt;/b&gt;: NSG drops source 10.1.1.4&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;HTTP 4xx&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;cross-spoke only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;steer = false, NSG off&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;HTTP 4xx, &lt;b&gt;bypass&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;HTTP 4xx&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;cross-spoke only: the gap&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;disable_snat_on_pl, steer = true&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:28%;&quot;&gt;HTTP 4xx&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:18%;&quot;&gt;HTTP 4xx&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:26%;&quot;&gt;real client IPs logged&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FFFFFF;strokeColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1760" height="430" as="geometry"/></mxCell>
<mxCell id="tr" value="&lt;b&gt;When it doesn&#x27;t work&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:1700px;font-size:17px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:32%;&quot;&gt;Symptom&lt;/th&gt;&lt;th style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;background:#E1DFDD;width:68%;&quot;&gt;Check&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:32%;&quot;&gt;Still bypasses, no firewall session&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:68%;&quot;&gt;Network policies on the PE subnet? UDR prefix at least as long as the VNet&#x27;s? Route table on the right subnet?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:32%;&quot;&gt;Session in the firewall, then timeout&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:68%;&quot;&gt;Asymmetric return: add SNAT or the disableSnatOnPL tag&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:32%;&quot;&gt;Firewall log shows deny on intrazone-default&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:68%;&quot;&gt;Rule app-to-private-endpoints missing or the address groups are wrong&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:32%;&quot;&gt;Name resolves to a public IP&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:68%;&quot;&gt;Zone link missing for that VNet, or custom DNS not forwarding to Azure DNS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:32%;&quot;&gt;ILB backend unhealthy&lt;/td&gt;&lt;td style=&quot;border:1px solid #A19F9D;padding:4px 6px;text-align:left;width:68%;&quot;&gt;Management profile on ethernet1/2 and the 168.63.129.16 route&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=20;fontColor=#201F1E;fillColor=#FDECEC;strokeColor=#C50F1F;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1760" height="360" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>