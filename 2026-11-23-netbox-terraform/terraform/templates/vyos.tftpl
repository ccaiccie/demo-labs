# Standardized VyOS CLI Configuration
# Generated by Terraform from NetBox Source of Truth
# Device: ${device_name} | Site: ${site_name}

set system host-name '${device_name}'

# --- Interface Settings (from NetBox Interfaces & IP Addresses) ---
%{ for key, obj in address_objects ~}
set interfaces ethernet ${obj.iface_name} address '${obj.gateway_ip}'
set interfaces ethernet ${obj.iface_name} description '${obj.description}'
%{ endfor ~}

# --- Firewall Address Groups (from NetBox Prefixes) ---
%{ for key, obj in address_objects ~}
set firewall group network-group ${obj.name} network '${obj.cidr}'
set firewall group network-group ${obj.name} description '${obj.vlan_name} (VLAN ${obj.vlan_id})'
%{ endfor ~}

# --- Standardized Firewall Policies ---
set firewall ipv4 forward filter default-action 'drop'
%{ for pol in policies ~}
set firewall ipv4 forward filter rule ${pol.id} action '${pol.action}'
set firewall ipv4 forward filter rule ${pol.id} description '${pol.name}'
set firewall ipv4 forward filter rule ${pol.id} source group network-group '${pol.src_obj}'
set firewall ipv4 forward filter rule ${pol.id} destination group network-group '${pol.dst_obj}'
%{ if pol.port > 0 ~}
set firewall ipv4 forward filter rule ${pol.id} protocol '${pol.protocol}'
set firewall ipv4 forward filter rule ${pol.id} destination port '${pol.port}'
%{ endif ~}
%{ endfor ~}
commit
save
