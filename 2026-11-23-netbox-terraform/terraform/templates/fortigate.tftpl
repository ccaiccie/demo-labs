# Standardized FortiGate CLI Configuration
# Generated by Terraform from NetBox Source of Truth
# Device: ${device_name} | Site: ${site_name}

config system global
    set hostname "${device_name}"
end

# --- Interface Settings (from NetBox Interfaces & IP Addresses) ---
config system interface
%{ for key, obj in address_objects ~}
    edit "${obj.iface_name}"
        set ip ${obj.gateway_ip}
        set alias "${obj.zone}-VLAN${obj.vlan_id}"
        set description "${obj.description}"
        set allowaccess ping https ssh
    next
%{ endfor ~}
end

# --- Firewall Address Objects (from NetBox Prefixes) ---
config firewall address
%{ for key, obj in address_objects ~}
    edit "${obj.name}"
        set subnet ${obj.cidr}
        set comment "NetBox VLAN ${obj.vlan_id} (${obj.vlan_name})"
    next
%{ endfor ~}
end

# --- Standardized Firewall Policies ---
config firewall policy
%{ for pol in policies ~}
    edit ${pol.id}
        set name "${pol.name}"
        set srcintf "${pol.src_iface}"
        set dstintf "${pol.dst_iface}"
        set srcaddr "${pol.src_obj}"
        set dstaddr "${pol.dst_obj}"
        set action ${pol.action == "accept" ? "accept" : "deny"}
        set schedule "always"
        set service "${pol.port == 443 ? "HTTPS" : (pol.port == 53 ? "DNS" : (pol.port == 22 ? "SSH" : "ALL"))}"
        set logtraffic all
        set comments "${pol.description}"
    next
%{ endfor ~}
end
