#!/usr/sbin/nft -f
# Standardized nftables firewall configuration
# Generated by Terraform from NetBox Source of Truth
# Device: ${device_name} | Site: ${site_name}

table inet lab_fw
delete table inet lab_fw

table inet lab_fw {
  # Address Objects (derived from NetBox Prefixes)
%{ for key, obj in address_objects ~}
  set ${obj.name} {
    type ipv4_addr
    flags interval
    elements = { ${obj.cidr} }
  }
%{ endfor ~}

  chain forward {
    type filter hook forward priority 0; policy drop;

    # Allow established/related return traffic
    ct state established,related accept

    # Standardized Security Policies
%{ for pol in policies ~}
    # Rule ${pol.id}: ${pol.name} - ${pol.description}
%{ if pol.port > 0 ~}
    ip saddr @${pol.src_obj} ip daddr @${pol.dst_obj} ${pol.protocol} dport ${pol.port} ${pol.action} comment "${pol.name}"
%{ else ~}
    ip saddr @${pol.src_obj} ip daddr @${pol.dst_obj} ${pol.action} comment "${pol.name}"
%{ endif ~}
%{ endfor ~}

    # Explicit default deny with logging
    log prefix "LAB_FW_DROP: " drop
  }
}
