#!/usr/sbin/nft -f
# Standardized nftables firewall configuration
# Generated by Terraform from NetBox Source of Truth
# Device: fw-edge-01 | Site: Branch-West-DC1

table inet lab_fw
delete table inet lab_fw

table inet lab_fw {
  # Address Objects (derived from NetBox Prefixes)
  set NET_CORP_USERS {
    type ipv4_addr
    flags interval
    elements = { 198.51.100.0/24 }
  }
  set NET_DMZ_WEB {
    type ipv4_addr
    flags interval
    elements = { 203.0.113.0/24 }
  }
  set NET_MGMT_OOB {
    type ipv4_addr
    flags interval
    elements = { 192.0.2.0/24 }
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    # Allow established/related return traffic
    ct state established,related accept

    # Standardized Security Policies
    # Rule 10: allow-corp-to-dmz-https - Allow corporate users HTTPS access to DMZ web servers
    ip saddr @NET_CORP_USERS ip daddr @NET_DMZ_WEB tcp dport 443 accept comment "allow-corp-to-dmz-https"
    # Rule 20: allow-corp-to-dmz-dns - Allow corporate users DNS queries to DMZ resolvers
    ip saddr @NET_CORP_USERS ip daddr @NET_DMZ_WEB udp dport 53 accept comment "allow-corp-to-dmz-dns"
    # Rule 30: allow-mgmt-to-dmz-ssh - Allow management subnet SSH administration to DMZ hosts
    ip saddr @NET_MGMT_OOB ip daddr @NET_DMZ_WEB tcp dport 22 accept comment "allow-mgmt-to-dmz-ssh"
    # Rule 40: deny-dmz-to-corp-all - Explicitly block DMZ hosts from initiating traffic to corporate LAN
    ip saddr @NET_DMZ_WEB ip daddr @NET_CORP_USERS drop comment "deny-dmz-to-corp-all"

    # Explicit default deny with logging
    log prefix "LAB_FW_DROP: " drop
  }
}
