# Copy to .env and run: chmod 600 .env
# Never commit .env. Do not paste real keys into config.json, compose, the UI chat, or the README.

# Reuse an existing OpenAI key. Keep spend on gpt-4o-mini and text-embedding-3-small only.
OPENAI_API_KEY=sk-your-key-here

# Random 32-byte hex used by Bifrost to encrypt stored credentials.
# Generate with: openssl rand -hex 32
BIFROST_ENCRYPTION_KEY=change-me

# Required before you can create the first dashboard admin (v2.6.0+).
# Generate with: openssl rand -hex 32
# Send the same value in the X-Bifrost-Setup-Token header (or the UI Setup token field).
BIFROST_SETUP_TOKEN=change-me

# Local dashboard admin (not an OpenAI key, not a personal Google account).
BIFROST_ADMIN_USERNAME=netops-admin
BIFROST_ADMIN_PASSWORD=change-me-strong-password

# Demo virtual keys issued to client apps (not the OpenAI key).
# Generate with: echo sk-bf-netops-$(openssl rand -hex 16)
VK_NETOPS=sk-bf-netops-change-me
VK_LIMITED=sk-bf-limited-change-me
VK_BUDGET=sk-bf-budget-change-me
