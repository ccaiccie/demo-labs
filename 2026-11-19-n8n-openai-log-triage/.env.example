# Copy to .env and run: chmod 600 .env
# Random key n8n uses to encrypt saved credentials. Generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me
# Your OpenAI API key. It is NOT passed to any container; paste it into the
# n8n OpenAI credential dialog (stored encrypted in n8n). Keep this file private.
OPENAI_API_KEY=sk-your-key-here
